PROG -> COMPOUND_BLOCK END
	COMPOUND_BLOCK -> BLOCK*
		BLOCK -> CONTROL_FLOW | LOC | FUNCTION_DEFINITION | CLASS_DEFINITION | ENUM_DEFINITION | IMPORT_LINE | ERROR_BLOCK
			EXPRESSION -> E0 | TERNARY_OPERATOR
				TERNARY_OPERATOR -> E0 '?' EXPRESSION ':' EXPRESSION
				// TERNARY_OPERATOR -> 'if' '(' EXPRESSION ')' ENTER_SCOPE EXPRESSION EXIT_SCOPE 'else' ENTER_SCOPE EXPRESSION EXIT_SCOPE
				EXPRESSION_IF -> 'if' EXPRESSION ':' EXPRESSION EXPRESSION_ELIF_CHAIN? EXPRESSION_ELSE
					// EXPRESSION_ELIF_CHAIN -> EXPRESSION_ELIF_CHAIN? 'elif' EXPRESSION ':' ENTER_SCOPE EXPRESSION EXIT_SCOPE
					EXPRESSION_ELSE -> 'else' ENTER_SCOPE EXPRESSION EXIT_SCOPE
				E0 -> E0 '||' E1 | E1
				E1 -> E1 '&&' E2 | E2
				E2 -> E2 (('==' | '!=') E2b)*
				E2b -> E2b (('<' | '>' | '<=' | '>=') E3)*
				E3 -> E3 '|' E3b | E3b
				E3b -> E3b '^' E3c | E3c
				E3c -> E3c '&' E3d | E3d
				E3d -> E3d '<<' E4 | E3d '>>' E4 | E4
				E4 -> E4 '+' E5 | E4 '-' E5 | E5
				E5 -> E5 '*' E6 | E5 '/' E6 | E5 '%' E6 | E6
				E6 -> ('!' | '-' | '~') E7 | E7
				E7 -> E8 '**' E6 | E8
				E8 -> LITERAL | VVALUE
				VVALUE -> LH_VVALUE_UNARY V1 | V1
				V1 -> V1 ('.' | '->') V2 | V2 
				V2 -> V2 '[' EXPRESSION ']' | V3
				V3 -> VUNIT | ARRAY_EXPRESSION | '(' EXPRESSION ')'
					ARRAY_EXPRESSION -> '[' EXPRESSION_LIST? ']'
				VUNIT -> ID | FUNCTION_CALL
					FUNCTION_CALL -> ID '(' EXPRESSION_LIST? ')'
						EXPRESSION_LIST -> EXPRESSION_LIST ',' EXPRESSION | EXPRESSION
				LH_VVALUE_UNARY -> '@' | '&'
			CONTROL_FLOW -> FOR_BLOCK | WHILE_BLOCK | IF_BLOCK ELIF_CHAIN? ELSE? | SWITCH_BLOCK | INLINE_CONTROL_FLOW
				BRANCH_BLOCK -> '(' EXPRESSION ')' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
				FOR_BLOCK -> 'for' '(' FOR_INNER ')' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
					FOR_INNER -> ID 'in' EXPRESSION
				WHILE_BLOCK -> 'while' BRANCH_BLOCK
				IF_BLOCK -> 'if' BRANCH_BLOCK
				ELIF_CHAIN -> ELIF_CHAIN? ELIF_BLOCK
					ELIF_BLOCK -> 'elif' BRANCH_BLOCK
				ELSE -> 'else' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
				SWITCH_BLOCK -> 'switch' '(' EXPRESSION ')' ENTER_SCOPE SWITCH_BODY+ EXIT_SCOPE
					SWITCH_BODY -> SWITCH_CASE_LIST '->' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
					SWITCH_CASE_LIST -> SWITCH_CASE_LIST? SWITCH_CASE
						SWITCH_CASE -> 'case' (LITERAL | (ID '.')* ID)
						SWITCH_CASE -> 'default'
				INLINE_CONTROL_FLOW -> INLINE_IF | INLINE_WHILE | INLINE_FOR
					INLINE_IF -> 'if' '(' EXPRESSION ')' LOC
					INLINE_WHILE -> 'while' '(' EXPRESSION ')' LOC
					INLINE_FOR -> 'for' '(' FOR_INNER ')' LOC
			LOC -> (VARIABLE_DECLARATION | VARIABLE_ASSIGNMENT | FUNCTION_CALL | VVALUE ('.' | '->') FUNCTION_CALL | BRANCH_STATEMENT | THROW_STATEMENT) LOC_END
				VARIABLE_DECLARATION -> VAR_LDECL '=' EXPRESSION | ID ':=' EXPRESSION | ID_LIST ':' TYPE
					TYPE -> 'const'? ID ('@'* '&'* (('[' ']')+ | ('[' EXPRESSION ']')+))? '@'* '&'*
					VAR_LDECL -> ID ':' TYPE
				VARIABLE_ASSIGNMENT -> ASSIGNMENT_VARIABLE '=' EXPRESSION | ASSIGNMENT_VARIABLE MODIFIED_ASSIGNMENT EXPRESSION | VUNARY ASSIGNMENT_VARIABLE | ASSIGNMENT_VARIABLE VUNARY
					MODIFIED_ASSIGNMENT -> '+=' | '-=' | '*=' | '/=' | '**=' | '%=' | '|=' | '^=' | '&=' | '<<=' | '>>='
					ASSIGNMENT_VARIABLE -> ID | VVALUE ('.' | '->') ID | VVALUE '[' EXPRESSION ']' | VVALUE '@'
					VUNARY -> '--' | '++'
				FUNCTION_CALL -> ID '(' ID_LIST? ')'
				BRANCH_STATEMENT -> 'return' EXPRESSION | 'break' | 'continue' | 'return'
				THROW_STATEMENT -> 'throw' EXPRESSION
			FUNCTION_DEFINITION -> ID '(' FUNCTION_DEF_ARG_LIST ')' (':' TYPE)? ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
				FUNCTION_DEF_ARG_LIST -> FUNCTION_DEF_ARG (',' FUNCTION_DEF_ARG)*
					FUNCTION_DEF_ARG -> VAR_LDECL
			ENUM_DEFINITION -> 'enum' ID ENTER_SCOPE ENUM_INNER EXIT_SCOPE
				ENUM_INNER -> ID_LIST
				ID_LIST -> ID_LIST ',' ID | ID
			IMPORT_LINE -> 'import' (WILDCARD_IMPORT | NOT_WILDCARD_IMPORT) LOC_END
				WILDCARD_IMPORT -> (ID '.')* '*' ('from' (ID '.')* ID)?
				NOT_WILDCARD_IMPORT -> (ID '.')* ID ('as' ID)? ('from' (ID '.')* ID)?
			ERROR_BLOCK -> TRY_BLOCK (EXCEPT_BLOCK+ FINALLY_BLOCK? | FINALLY_BLOCK)
				TRY_BLOCK -> 'try' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
				EXCEPT_BLOCK -> 'except' '(' VAR_LDECL ')' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
				FINALLY_BLOCK -> 'finally' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
			CLASS_DEFINITION -> 'class' ID ('extends' ID)? ENTER_SCOPE CLASS_DEF_BODY EXIT_SCOPE
				CLASS_DEF_BODY -> (CLASS_VAR_SECTION CLASS_FUNC_SECTION) | (CLASS_FUNC_SECTION CLASS_VAR_SECTION)
					CLASS_ACCESS_LEVEL -> 'protected' | 'private' | 'public'
					CLASS_VAR_SECTION -> (ID_LIST ':' CLASS_ACCESS_LEVEL TYPE LOC_END)+
					CLASS_FUNC_SECTION -> (CLASS_FUNCTION_DEFINITION | CLASS_CONSTRUCTOR | CLASS_DESTRUCTOR)+
						CLASS_CONSTRUCTOR -> ID '(' FUNCTION_DEF_ARGS? ')' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
						CLASS_DESTRUCTOR -> '~' ID '(' ')' ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE
						CLASS_FUNCTION_DEFINITION  -> ID '(' FUNCTION_DEF_ARG_LIST ')' ':' CLASS_ACCESS_LEVEL TYPE? ENTER_SCOPE COMPOUND_BLOCK EXIT_SCOPE

LOC_END -> '\n'
ENTER_SCOPE -> ':' '\n' INDENT
EXIT_SCOPE -> DEDENT
LITERAL -> NULL | NUMBER | STRING | BOOLEAN
LITERAL_LIST -> (LITERAL ',')* LITERAL | LITERAL
ITERABLE -> RANGE_GENERATOR
RANGE_GENERATOR -> E0 ':' E0 (':' E0)?
