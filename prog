class string {
	loc: public @char
	size, capacity: public size_t

	string() {
		this(0)
	}

	string(init_size: size_t) {
		capacity = init_size
		size = init_size
		loc = malloc(init_size * char.size())
	}

	size(): public size_t {
		return size
	}

	operator_bracket(i: size_t): public char {
		if i >= size {
			return '\0'
		}
		return (loc + i)@
	}

	operator_plus(rhs: string) {
		total: string = string(size + rhs.size())
		total += this
		total += rhs
		return total
	}

	operator_plus_equals(rhs: string) {
		newsize: size_t = size + rhs.size()
		if newsize > capacity {
			grow(newsize)
		}
		copyto(loc + size, rhs.loc)
	}

	grow(new_size: size_t): private {
		new_cap: size_t
		if capacity == 0.0 {
			new_cap = new_size
		} elif newsize > 2 * capacity {
			new_cap = new_size
		} else {
			new_cap = capacity * 2
		}

		free(loc)
		loc = malloc(new_cap * char.size())
		capacity = new_cap
	}
}
